      "id": "A",
      "layer": "shared-kernel-public",
      "testClass": "org.geocedg.common.locus.G9U0R4IntersectionAdmissibilityContinuationTest",
      "cases": [
        {"id": "R4-A01", "method": "authorFourSolutionFixtureUsesFourIntrinsicSemanticSelectors", "title": "The byte-exact four-solution fixture publishes four unique intrinsic phase selectors and four materializable exact tokens without upgrading completeness or certification"},
        {"id": "R4-A02", "method": "authorFourSolutionSelectorsIgnoreEverySolverPermutation", "title": "Every solver enumeration permutation produces the same four semantic selector/token associations"},
        {"id": "R4-A03", "method": "authorFourSolutionBindingsArePathIndependentAndMoveRegularly", "title": "Four materialized roots reach the same regular final bindings through direct, incremental, reversing and reopened histories"},
        {"id": "R4-A04", "method": "authorFourSolutionPointsRemainDefinedThroughoutRegularMotion", "title": "All four exact-token points remain defined and unswapped throughout ordinary seam-free motion"},
        {"id": "R4-A05", "method": "authorMidpointCircleRootsAreInitiallyPointAdmissible", "title": "The byte-exact midpoint/circle fixture publishes two distinct locally admissible initial roots"},
        {"id": "R4-A06", "method": "publishedR3SingletonPositiveControlRemainsAdmissible", "title": "The published singleton-line positive control remains admissible"},
        {"id": "R4-A07", "method": "preR4V1XmlTokenPointMigratesWithoutTokenChangeAndTracksMotion", "title": "A real pre-R4 format-v1 XML ledger and materialized token point import into canonical v4 without changing token material and then follow regular motion"},
        {"id": "R4-A08", "method": "authorTokenPointsSurviveSaveReopenAndSameStateRecompute", "title": "Author-fixture token points survive reconstruction, regular target motion and same-state recompute"},
        {"id": "R4-A09", "method": "authorMidpointDirectRegularMotionRetainsExactTokenPoints", "title": "One direct regular update retains both exact-token midpoint points"},
        {"id": "R4-A10", "method": "authorMidpointBindingIsPathIndependentAcrossRegularHistories", "title": "Direct, incremental, reversing and reopened paths reach the same deterministic final binding"},
        {"id": "R4-A11", "method": "authorMidpointBroadRegularMotionIsContinuousAndDoesNotSwap", "title": "Broad regular midpoint/circle motion keeps both points defined, continuous and unswapped"},
        {"id": "R4-A12", "method": "materializedAuthorTokenPointUsesNormalUndoRedoLifecycle", "title": "A materialized author-fixture token point follows normal undo and redo lifecycle"},
        {"id": "R4-A13", "method": "localAdmissibilityRemainsIndependentOfGlobalCompleteness", "title": "Unresolved evidence blocks a root on the same semantic component but not an established root on another component, independently of global completeness"},
        {"id": "R4-A14", "method": "disappearanceNewAppearanceAndTangencyRemainFailClosed", "title": "Disappearance, new appearance and tangency invalidate rather than transfer identity"},
        {"id": "R4-A15", "method": "periodicSeamIsCanonicalAndDoesNotDuplicateTheBoundaryRoot", "title": "Equivalent half-open periodic-seam parameters produce one canonical root"},
        {"id": "R4-A16", "method": "orientedRootCrossesPeriodicSeamWithoutDuplicateOrTokenSwap", "title": "A unique base selector crosses an exact complete periodic seam without duplication or token swap"},
        {"id": "R4-A17", "method": "stableTransverseMotionUsesDeterministicCurrentSelectors", "title": "Stable transverse motion resolves exact tokens from unique current-snapshot selectors"},
        {"id": "R4-A18", "method": "spatialLeftRightOrderCanReverseWithoutTokenSwap", "title": "Two roots may reverse Cartesian left/right order without defining or swapping identity"},
        {"id": "R4-A19", "method": "uniqueDeterministicSelectorSurvivesUnobservedDirectUpdate", "title": "A unique deterministic selector survives an unobserved direct regular update without movement-history authority"},
        {"id": "R4-A20", "method": "repeatedDeterministicSelectorsUseIntrinsicSemanticRank", "title": "Repeated base selectors use only the intrinsic oriented semantic phase/rank and never solver/list order"},
        {"id": "R4-A21", "method": "rankedCollisionGroupAppearanceAndDisappearanceInvalidatesWithoutShift", "title": "Collision-cardinality/topology change invalidates ranked tokens instead of transferring them to a new rank occupant"},
        {"id": "R4-A22", "method": "reversingProviderOrientationNeverTransfersRankedTokensWithoutMap", "title": "Provider orientation reversal cannot reuse ranked tokens without an explicit semantic map"},
        {"id": "R4-A23", "method": "rankedPeriodicSeamInvalidatesInsteadOfRotatingOpaqueTokens", "title": "Incremental seam traversal and a direct phase 0 to -0.1 update fail closed selectively: the affected two-root germ group publishes typed transition parents and retires its old tokens, while the unaffected two-root group remains current; settled recompute exposes admissible fresh tokens only for the affected group"},
        {"id": "R4-A24", "method": "mergeCandidateParentKeysRemainExplicitAndNonAdmissible", "title": "Merge-candidate parent tokens and keys remain explicit, canonically ordered and point-inadmissible"},
        {"id": "R4-A25", "method": "stableSupportedTargetFamiliesReceiveExactOrFailClosedEvidence", "title": "Supported target families receive exact evidence or fail closed, and equivalent nonzero scalar target representations preserve canonical selectors and tokens"},
        {"id": "R4-A26", "method": "authorFourSolutionCenterDragIgnoresUiUpdateGranularity", "title": "One ordinary UI-sized center update and forty smaller updates to the same regular geometry retain identical selectors, tokens and existing materialized-point bindings under the adaptive intrinsic phase-tube certificate"},
        {"id": "R4-A27", "method": "existingTwoRootPointsReactivateAfterFourRootTopologyRecurrence", "title": "Across direct, staged, reopened-dormant, many-small and forward/reverse 2-to-4-to-2 paths, the same two existing GeoPoints become dormant and then reactivate under their exact selectors; topology recompute creates no new GeoPoint"}
      ]
    },
