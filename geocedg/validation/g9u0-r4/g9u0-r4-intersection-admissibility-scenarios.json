        {"id": "R4-L22", "method": "deterministicSelectorResolvesMovedAddressWithoutHistory", "title": "The same selector resolves a moved revision address without previous-root history"},
        {"id": "R4-L23", "method": "multiRootCopyUsesOneSemanticMappingPerSharedLegacyIncarnation", "title": "Legacy shared-incarnation copy requires one semantic source-to-copy mapping per root"},
        {"id": "R4-L24", "method": "claimedAllocationBecomesDormantAndReactivatesByExactSelector", "title": "A materialized claim becomes noncurrent but retained dormant during ordinary absence, then reactivates with the exact same opaque token when its selector returns"},
        {"id": "R4-L25", "method": "materializedClaimReferenceCountPrunesOnlyAfterLastRelease", "title": "A dormant materialized allocation remains retained until its last exact claim is released, after which recurrence receives fresh token material"},
        {"id": "R4-L26", "method": "explicitPermanentRetirementPreventsDormantReactivation", "title": "The typed permanent-retirement seam removes even a claimed allocation and prevents later dormant reactivation"},
        {"id": "R4-L27", "method": "authorizedCopyRebasesDormantClaimBeforeRootReappears", "title": "An authorized exact-provenance copy rebases a dormant claim before recurrence and reactivates the copied token only when its exact selector returns"},
