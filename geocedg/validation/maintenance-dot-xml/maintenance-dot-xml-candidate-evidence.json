  "rootCause": [
    "ExpressionSerializer case DOT (non-GIAC) passed loc.getCommand(\"Dot\") to twoVar for every string template, GEOGEBRA_XML included, ignoring StringTemplate.isPrintLocalizedCommandNames()",
    "xmlTemplate sets localizeCmds=false; Command.toString, appendIfCommand and the DataFunction head already honour that flag",
    "the XML strategy keeps command heads verbatim (Command constructor), so a localized head is an unknown command on load and the later numeric element creates an independent number"
  ],
  "baseReproduction": {
    "DotXmlLocaleIndependentSerializationTest": {
      "tests": 8,
      "failed": 5,
      "passedControls": ["localizedPresentationTemplatesKeepTheCurrentHead", "ifNeighbourAlreadyFollowsTheSameTemplateConvention", "historicalLocalizedHeadIsNotReinterpretedByTheXmlReader"],
      "observed": [
        "ES xmlTemplate head ProductoEscalar(u, v)",
        "ES expression elements ProductoEscalar(u, v) and (2 * ProductoEscalar(u, v)); EN Dot(u, v) and (2 * Dot(u, v))",
        "ES noLocalDefault head ProductoEscalar(u, v)",
        "after XML reload in EN or ES, d independent",
        "after ES undo restore, d independent"
      ]
    },
    "DotXmlLocaleIndependentPersistenceTest": {
      "tests": 3,
      "failed": 3,
      "observed": "ES native .cedg (Save As) and ES Classic-written .ggb archives contain ProductoEscalar heads"
    },
    "scratchProbe": {
      "committed": false,
      "observed": [
        "ES native Save As returns true; save preflight logs error in <expression> through ErrorHelper$SilentErrorHandler and accepts",
        "reopen in EN or ES: loadFile true; d and e independent GeoNumeric, no parent, values 11 and 22; u=(3,4) leaves 11 and 22",
        "EN-authored document round-trips: Dot(u, v), recomputes to 25 and 50"
      ]
    }
  },
  "fix": {
    "site": "ExpressionSerializer case DOT, non-GIAC branch",
    "change": "head = tpl.isPrintLocalizedCommandNames() ? loc.getCommand(\"Dot\") : \"Dot\"",
    "convention": "Command.toString, appendIfCommand (Operation.IF), DataFunction head",
    "unchangedCode": ["twoVar", "GIAC branch", "every other operation", "StringTemplate", "MyXMLHandler", "Command", "CommandLookupStrategy"]
