{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geocedg.local/schemas/knowledge-bundle-v1",
  "title": "GeoCeDG deterministic knowledge bundle manifest",
  "description": "NORMATIVE / AUTHOR APPROVED; G9O1 is authorized and not started, and no productive generator exists yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "generator",
    "repository",
    "baseline",
    "configuration",
    "bundle_id",
    "profile",
    "entries"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "geocedg-knowledge-bundle" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "branch", "commit", "dirty"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "branch": { "type": ["string", "null"] },
        "commit": { "$ref": "#/$defs/gitObject" },
        "dirty": { "type": "boolean" },
        "dirty_diff_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "dirty": { "const": true } }, "required": ["dirty"] },
          "then": { "required": ["dirty_diff_sha256"] }
        }
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "commit"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/gitObject" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "include_diffs", "budgets", "canonical_sha256"],
      "properties": {
        "profile_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "themes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "include_diffs": { "type": "boolean" },
        "budgets": { "$ref": "#/$defs/budgets" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bundle_id": { "type": "string", "pattern": "^kb-v1-[a-f0-9]{64}$" },
    "profile": { "enum": ["source", "knowledge", "thematic"] },
    "reading_order": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitObject": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_files", "maximum_bytes", "maximum_tokens"],
      "properties": {
        "maximum_files": { "type": "integer", "minimum": 1 },
        "maximum_bytes": { "type": "integer", "minimum": 1 },
        "maximum_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "lineRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "total", "complete_source_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 2 },
        "complete_source_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "ownership_class",
        "language",
        "encoding",
        "line_range",
        "sha256",
        "change_type",
        "related_specs",
        "related_adrs",
        "related_phases",
        "related_tests",
        "license_provenance",
        "order"
      ],
      "properties": {
        "source_path": { "$ref": "#/$defs/repoPath" },
        "ownership_class": {
          "enum": [
            "GEOCEDG_NATIVE",
            "UPSTREAM_MODIFIED",
            "UPSTREAM_UNCHANGED_REFERENCE",
            "GENERATED",
            "THIRD_PARTY_OR_RESTRICTED"
          ]
        },
        "language": { "type": "string", "minLength": 1 },
        "encoding": { "const": "UTF-8" },
        "line_range": { "$ref": "#/$defs/lineRange" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "baseline_blob_sha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
        "change_type": { "enum": ["ADDED", "MODIFIED", "UNCHANGED_REFERENCE"] },
        "change_summary": { "type": "string" },
        "unified_diff_path": { "$ref": "#/$defs/repoPath" },
        "related_specs": { "type": "array", "items": { "$ref": "#/$defs/repoPath" }, "uniqueItems": true },
        "related_adrs": { "type": "array", "items": { "$ref": "#/$defs/repoPath" }, "uniqueItems": true },
        "related_phases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "related_tests": { "type": "array", "items": { "$ref": "#/$defs/repoPath" }, "uniqueItems": true },
        "license_provenance": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "continuation": { "$ref": "#/$defs/continuation" }
      },
      "allOf": [
        {
          "if": { "properties": { "ownership_class": { "const": "UPSTREAM_MODIFIED" } }, "required": ["ownership_class"] },
          "then": { "required": ["baseline_blob_sha", "change_summary"] }
        }
      ]
    }
  }
}
