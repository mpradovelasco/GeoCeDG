{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geocedg.local/schemas/verification-registry-v2",
  "title": "GeoCeDG typed verification registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "registry_id", "catalogs", "profiles", "compatibility_mappings", "phase_selections", "nodes"],
  "properties": {
    "$schema": { "const": "geocedg/specs/operations/verification-registry.schema.json" },
    "schema_version": { "const": 2 },
    "registry_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "catalogs": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/catalog" } },
    "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/profile" } },
    "compatibility_mappings": { "type": "array", "items": { "$ref": "#/$defs/compatibilityMapping" } },
    "phase_selections": { "type": "array", "items": { "$ref": "#/$defs/phaseSelection" } },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
  },
  "$defs": {
    "profileId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "checkId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "acceptanceClass": {
      "enum": ["SEMANTIC", "SAFETY", "VERIFICATION_CORE"]
    },
    "diagnosticClass": {
      "enum": ["GOVERNANCE_DIAGNOSTIC", "DOCUMENTATION_DIAGNOSTIC", "HISTORICAL_CONSISTENCY_DIAGNOSTIC", "STYLE_DIAGNOSTIC", "PERFORMANCE_TELEMETRY"]
    },
    "contractClass": {
      "oneOf": [{ "$ref": "#/$defs/acceptanceClass" }, { "$ref": "#/$defs/diagnosticClass" }]
    },
    "semanticDomain": { "enum": ["PRODUCT", "SCIENTIFIC", "MIXED"] },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "path", "sha256"],
      "properties": {
        "catalog_id": { "enum": ["junit_inventory", "static_contracts"] },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "coverage_state", "missing_check_ids"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/profileId" },
        "coverage_state": { "enum": ["COMPLETE", "INCOMPLETE"] },
        "missing_check_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/checkId" } }
      },
      "allOf": [
        {
          "if": { "properties": { "coverage_state": { "const": "COMPLETE" } }, "required": ["coverage_state"] },
          "then": { "properties": { "missing_check_ids": { "maxItems": 0 } } },
          "else": { "properties": { "missing_check_ids": { "minItems": 1 } } }
        }
      ]
    },
    "compatibilityMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "profile"],
      "properties": {
        "selector": { "enum": ["DEV", "PHASE", "COMPOSED", "FULL", "FullTests"] },
        "profile": { "$ref": "#/$defs/profileId" }
      }
    },
    "phaseSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_id", "coverage_state", "missing_check_ids", "required_check_ids"],
      "properties": {
        "phase_id": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
        "coverage_state": { "enum": ["COMPLETE", "INCOMPLETE"] },
        "missing_check_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/checkId" } },
        "required_check_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/checkId" } }
      },
      "allOf": [{ "if": { "properties": { "coverage_state": { "const": "COMPLETE" } } }, "then": { "properties": { "missing_check_ids": { "maxItems": 0 } } }, "else": { "properties": { "missing_check_ids": { "minItems": 1 } } } }]
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\:\\u0000]+(?:/[^/\\\\:\\u0000]+)*$",
      "not": { "pattern": "(^|/)\\.\\.?(/|$)|\\\\|^[A-Za-z]:|^/" }
    },
    "workingDirectory": {
      "oneOf": [
        { "const": "." },
        { "$ref": "#/$defs/repositoryPath" }
      ]
    },
    "impactPath": {
      "oneOf": [
        { "const": "." },
        { "$ref": "#/$defs/repositoryPath" }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity"],
      "properties": {
        "kind": { "enum": ["PROCESS", "BUILTIN_PROJECTION"] },
        "identity": { "type": "string", "minLength": 1 },
        "executable": { "type": "string", "minLength": 1 },
        "projection": { "enum": ["EXIT_CODE_ZERO", "STRUCTURED_CONTRACT", "EVIDENCE_PRESENT", "JUNIT_SELECTION", "PROCESS_EXIT", "PYTHON_CHECK"] },
        "evidence_name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "structured_output": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.json$" },
        "selection_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" }
      },
      "oneOf": [
        {
          "properties": { "kind": { "const": "PROCESS" } },
          "required": ["executable"],
          "not": { "anyOf": [{ "required": ["projection"] }, { "required": ["evidence_name"] }] }
        },
        {
          "properties": { "kind": { "const": "BUILTIN_PROJECTION" } },
          "required": ["projection"],
          "not": { "anyOf": [{ "required": ["executable"] }, { "required": ["structured_output"] }] }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": { "projection": { "enum": ["STRUCTURED_CONTRACT", "EVIDENCE_PRESENT"] } },
            "required": ["projection"]
          },
          "then": { "required": ["evidence_name"] },
          "else": { "not": { "required": ["evidence_name"] } }
        }
      ]
    },
    "environmentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inherit", "variables"],
      "properties": {
        "inherit": { "type": "boolean" },
        "variables": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_()]*$" }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "node_kind", "tier", "command", "argv", "working_directory", "dependencies", "platforms", "impact_paths", "environment_contract", "resource_locks", "side_effects", "output_adapter", "required_for_profiles"],
      "properties": {
        "check_id": { "$ref": "#/$defs/checkId" },
        "node_kind": { "enum": ["PROCESS_PRODUCER", "ACCEPTANCE_LEAF", "DIAGNOSTIC_LEAF", "EVIDENCE_PROJECTION"] },
        "contract_class": { "$ref": "#/$defs/contractClass" },
        "semantic_domain": { "$ref": "#/$defs/semanticDomain" },
        "tier": { "enum": ["STATIC", "INFRA_UNIT", "FOCUSED", "INTEGRATION", "FINAL"] },
        "command": { "$ref": "#/$defs/command" },
        "argv": { "type": "array", "items": { "type": "string" } },
        "working_directory": { "$ref": "#/$defs/workingDirectory" },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/checkId" } },
        "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["WINDOWS", "LINUX", "MACOS"] } },
        "impact_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/impactPath" } },
        "environment_contract": { "$ref": "#/$defs/environmentContract" },
        "resource_locks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" } },
        "side_effects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["NONE", "TASK_OWNED_OUTPUT", "BUILD_OUTPUT", "REPOSITORY_READ"] } },
        "output_adapter": { "enum": ["RAW_PROCESS_V1", "EXIT_CODE_V1", "STRUCTURED_CONTRACT_V1", "PROJECTION_EXIT_CODE_V1", "PROJECTION_STRUCTURED_CONTRACT_V1", "PROJECTION_EVIDENCE_PRESENT_V1", "PROJECTION_JUNIT_SELECTION_V1", "PROJECTION_PROCESS_EXIT_V1", "PROJECTION_PYTHON_CHECK_V1"] },
        "required_for_profiles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/profileId" } },
        "produces_evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
        "producer_dependency": { "$ref": "#/$defs/checkId" }
      },
      "allOf": [{ "if": { "properties": { "contract_class": { "const": "SEMANTIC" } }, "required": ["contract_class"] }, "then": { "required": ["semantic_domain"] }, "else": { "not": { "required": ["semantic_domain"] } } }],
      "oneOf": [
        {
          "properties": {
            "node_kind": { "const": "PROCESS_PRODUCER" },
            "command": { "properties": { "kind": { "const": "PROCESS" } } },
            "output_adapter": { "const": "RAW_PROCESS_V1" }
          },
          "required": ["node_kind", "produces_evidence"],
          "not": { "anyOf": [{ "required": ["contract_class"] }, { "required": ["semantic_domain"] }, { "required": ["producer_dependency"] }] }
        },
        {
          "properties": {
            "node_kind": { "const": "ACCEPTANCE_LEAF" },
            "contract_class": { "$ref": "#/$defs/acceptanceClass" },
            "command": { "properties": { "kind": { "const": "PROCESS" } } },
            "output_adapter": { "enum": ["EXIT_CODE_V1", "STRUCTURED_CONTRACT_V1"] }
          },
          "required": ["node_kind", "contract_class"],
          "not": { "anyOf": [{ "required": ["produces_evidence"] }, { "required": ["producer_dependency"] }] }
        },
        {
          "properties": {
            "node_kind": { "const": "DIAGNOSTIC_LEAF" },
            "contract_class": { "$ref": "#/$defs/diagnosticClass" },
            "command": { "properties": { "kind": { "const": "PROCESS" } } },
            "output_adapter": { "enum": ["EXIT_CODE_V1", "STRUCTURED_CONTRACT_V1"] }
          },
          "required": ["node_kind", "contract_class"],
          "not": { "anyOf": [{ "required": ["produces_evidence"] }, { "required": ["producer_dependency"] }] }
        },
        {
          "properties": {
            "node_kind": { "const": "EVIDENCE_PROJECTION" },
            "command": { "properties": { "kind": { "const": "BUILTIN_PROJECTION" } } },
            "output_adapter": { "enum": ["PROJECTION_EXIT_CODE_V1", "PROJECTION_STRUCTURED_CONTRACT_V1", "PROJECTION_EVIDENCE_PRESENT_V1", "PROJECTION_JUNIT_SELECTION_V1", "PROJECTION_PROCESS_EXIT_V1", "PROJECTION_PYTHON_CHECK_V1"] }
          },
          "required": ["node_kind", "contract_class", "producer_dependency"],
          "not": { "required": ["produces_evidence"] }
        }
      ]
    }
  }
}
