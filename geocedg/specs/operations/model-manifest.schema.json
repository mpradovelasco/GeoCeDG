{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geocedg.local/schemas/model-manifest-v1",
  "title": "GeoCeDG model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "template",
    "id",
    "maturity",
    "source",
    "required_geogebra",
    "loaded_by_default",
    "inputs",
    "outputs",
    "validity_domain",
    "known_degeneracies",
    "reference_models",
    "expected_metrics",
    "license",
    "replacement_candidate"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "template": { "type": "boolean" },
    "id": { "type": "string", "pattern": "^cedg\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "maturity": { "enum": ["legacy", "research", "experimental", "stable", "deprecated"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "author", "date", "provenance_notes"],
      "properties": {
        "uri": { "type": "string" },
        "author": { "type": ["string", "null"] },
        "date": { "type": ["string", "null"] },
        "provenance_notes": { "type": "string" }
      }
    },
    "required_geogebra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "baseline_sha"],
      "properties": {
        "version": { "const": "5.4.928.0" },
        "baseline_sha": { "const": "9b93256b7df401ff056c37b502d82df4d72b1522" }
      }
    },
    "loaded_by_default": { "type": "boolean" },
    "inputs": { "type": "array" },
    "outputs": { "type": "array" },
    "validity_domain": {
      "type": "object",
      "required": ["description", "parameters"],
      "properties": {
        "description": { "type": "string" },
        "parameters": { "type": "array" }
      }
    },
    "known_degeneracies": { "type": "array" },
    "reference_models": { "type": "array" },
    "expected_metrics": { "type": "object" },
    "license": {
      "type": "object",
      "required": ["spdx", "evidence", "review_status"],
      "properties": {
        "spdx": { "type": ["string", "null"] },
        "evidence": { "type": "string" },
        "review_status": { "enum": ["unreviewed", "reviewed", "blocked"] }
      }
    },
    "replacement_candidate": { "type": ["string", "null"] },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "sha256", "immutable"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "format": { "enum": ["ggb", "ggt", "geogebrascript", "javascript"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "immutable": { "const": true }
      }
    },
    "source_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geogebra_version", "app", "platform"],
      "properties": {
        "geogebra_version": { "type": ["string", "null"] },
        "app": { "type": ["string", "null"] },
        "platform": { "type": ["string", "null"] }
      }
    },
    "derived_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "enum": ["curation", "inventory", "regression-evidence"] }
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanisms", "embedded_tools", "global_javascript"],
      "properties": {
        "mechanisms": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "embedded_tools": { "type": ["integer", "null"], "minimum": 0 },
        "global_javascript": { "type": ["boolean", "null"] }
      }
    },
    "publications": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "laboratory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "loader", "stable_toolbar_replaced"],
      "properties": {
        "eligible": { "type": "boolean" },
        "loader": { "type": "string", "minLength": 1 },
        "stable_toolbar_replaced": { "const": false }
      }
    }
  }
}
