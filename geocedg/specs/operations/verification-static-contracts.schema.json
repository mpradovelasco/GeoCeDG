{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://geocedg.local/schemas/verification-static-contracts-v1","type":"object","additionalProperties":false,
  "required":["$schema","schema_version","catalog_id","identity_mode","contracts"],"properties":{"$schema":{"const":"geocedg/specs/operations/verification-static-contracts.schema.json"},"schema_version":{"const":1},"catalog_id":{"const":"static_contracts"},"identity_mode":{"const":"canonical_utf8_lf_v1"},"contracts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/contract"}}},
  "$defs":{"contract":{"type":"object","additionalProperties":false,"required":["contract_id","semantic_domain","inputs"],"properties":{"contract_id":{"type":"string","pattern":"^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},"semantic_domain":{"enum":["PRODUCT","SCIENTIFIC","MIXED"]},"inputs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","pattern":"^[^/\\\\:\\u0000]+(?:/[^/\\\\:\\u0000]+)*$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}}}
