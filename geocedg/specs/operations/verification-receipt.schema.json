{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geocedg.local/schemas/verification-receipt-v1",
  "title": "GeoCeDG immutable acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "receipt_kind", "receipt_id", "accepted_report_hash",
    "base_commit", "base_tree", "candidate_commit", "candidate_tree", "execution_plan_hash",
    "checker_identity_hash", "environment_fingerprint", "input_identity_hash",
    "accepted_profiles", "diagnostic_hashes", "issued_at"
  ],
  "properties": {
    "$schema": { "const": "geocedg/specs/operations/verification-receipt.schema.json" },
    "schema_version": { "const": 1 },
    "receipt_kind": { "const": "GEOCEDG_ACCEPTANCE_RECEIPT" },
    "receipt_id": { "$ref": "#/$defs/hash" },
    "accepted_report_hash": { "$ref": "#/$defs/hash" },
    "base_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "base_tree": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "candidate_commit": { "$ref": "#/$defs/gitObject" },
    "candidate_tree": { "$ref": "#/$defs/gitObject" },
    "execution_plan_hash": { "$ref": "#/$defs/hash" },
    "checker_identity_hash": { "$ref": "#/$defs/hash" },
    "environment_fingerprint": { "$ref": "#/$defs/hash" },
    "input_identity_hash": { "$ref": "#/$defs/hash" },
    "accepted_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    },
    "diagnostic_hashes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hash" }
    },
    "issued_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
