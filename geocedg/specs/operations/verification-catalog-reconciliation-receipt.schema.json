{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geocedg.local/schemas/verification-catalog-reconciliation-receipt-v1",
  "title": "GeoCeDG post-run deterministic catalog reconciliation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "receipt_kind", "receipt_id", "mechanismVersion",
    "bootstrapAdoption", "mechanismCommit", "mechanismTree",
    "reviewedTechnicalCommit", "reviewedTechnicalTree",
    "reconciliationCommit", "reconciliationTree",
    "sourceVerificationRun", "sourceVerificationProfile",
    "sourceVerificationResultHash", "sourceVerificationResultFileSha256",
    "sourceVerificationStatus", "sourceAcceptanceVerdict", "sourceCoverageVerdict",
    "sourceRunReinterpreted", "sourceExecutionPlanHash", "reconciledExecutionPlanHash",
    "reconciliationReason", "sourceUntrustedChecks", "sourceAcceptanceSummary",
    "sourceSelectionId", "sourceProjectionCheckId", "sourceProducerCheckId",
    "sourceExpectedIdentityCount", "sourceExpectedIdentitiesSha256",
    "executedIdentityCount", "executedIdentitiesSha256", "executedEvidenceHashes",
    "reconciledExpectedIdentityCount", "reconciledExpectedIdentitiesSha256",
    "counterfactualProjection", "otherJunitSelections",
    "inventoryHashBefore", "inventoryHashAfter", "registryPinBefore", "registryPinAfter",
    "discoveryEvidence", "delta",
    "productPayloadUnchanged", "scientificTestsUnchanged", "buildAuthorityUnchanged",
    "numericalReferencesUnchanged", "toolchainUnchanged", "verifierExecutionUnchanged",
    "heavyExecutionAuthoritiesUnchanged", "heavyExecutionPlanUnchanged",
    "acceptanceSemanticsUnchanged", "heavyCampaignRerun",
    "reconciliationStatus", "technicalAcceptanceEligible",
    "checkerIdentity", "inputIdentity", "environment", "locators", "issued_at"
  ],
  "properties": {
    "$schema": { "const": "geocedg/specs/operations/verification-catalog-reconciliation-receipt.schema.json" },
    "schema_version": { "const": 1 },
    "receipt_kind": { "const": "GEOCEDG_POST_RUN_CATALOG_RECONCILIATION" },
    "receipt_id": { "$ref": "#/$defs/sha256" },
    "mechanismVersion": { "const": "post-run-catalog-reconciliation/v1" },
    "bootstrapAdoption": { "type": "boolean" },
    "mechanismCommit": { "oneOf": [ { "$ref": "#/$defs/oid" }, { "type": "null" } ] },
    "mechanismTree": { "oneOf": [ { "$ref": "#/$defs/oid" }, { "type": "null" } ] },
    "reviewedTechnicalCommit": { "$ref": "#/$defs/oid" },
    "reviewedTechnicalTree": { "$ref": "#/$defs/oid" },
    "reconciliationCommit": { "$ref": "#/$defs/oid" },
    "reconciliationTree": { "$ref": "#/$defs/oid" },
    "sourceVerificationRun": { "type": "string", "pattern": "^verification-[0-9a-f]{32}$" },
    "sourceVerificationProfile": { "const": "FINAL" },
    "sourceVerificationResultHash": { "$ref": "#/$defs/sha256" },
    "sourceVerificationResultFileSha256": { "$ref": "#/$defs/sha256" },
    "sourceVerificationStatus": { "const": "REJECTED_VERIFICATION_CORE / UNTRUSTED" },
    "sourceAcceptanceVerdict": { "const": "REJECTED_VERIFICATION_CORE" },
    "sourceCoverageVerdict": { "const": "UNTRUSTED" },
    "sourceRunReinterpreted": { "const": false },
    "sourceExecutionPlanHash": { "$ref": "#/$defs/sha256" },
    "reconciledExecutionPlanHash": { "$ref": "#/$defs/sha256" },
    "reconciliationReason": { "const": "STALE_DERIVED_JUNIT_SELECTION_INVENTORY" },
    "sourceUntrustedChecks": {
      "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "minLength": 1 }
    },
    "sourceAcceptanceSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "satisfied", "violated", "untrusted", "notRun", "producers", "producersCompleted"],
      "properties": {
        "required": { "type": "integer", "minimum": 1 },
        "satisfied": { "type": "integer", "minimum": 0 },
        "violated": { "const": 0 },
        "untrusted": { "const": 1 },
        "notRun": { "const": 0 },
        "producers": { "type": "integer", "minimum": 1 },
        "producersCompleted": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceSelectionId": { "type": "string", "minLength": 1 },
    "sourceProjectionCheckId": { "type": "string", "minLength": 1 },
    "sourceProducerCheckId": { "type": "string", "minLength": 1 },
    "sourceExpectedIdentityCount": { "type": "integer", "minimum": 1 },
    "sourceExpectedIdentitiesSha256": { "$ref": "#/$defs/sha256" },
    "executedIdentityCount": { "type": "integer", "minimum": 1 },
    "executedIdentitiesSha256": { "$ref": "#/$defs/sha256" },
    "executedEvidenceHashes": {
      "type": "object", "additionalProperties": false,
      "required": ["structuredOutputSha256", "junitFileCount", "junitFilesSha256", "failedOrErrored"],
      "properties": {
        "structuredOutputSha256": { "$ref": "#/$defs/sha256" },
        "junitFileCount": { "type": "integer", "minimum": 1 },
        "junitFilesSha256": { "$ref": "#/$defs/sha256" },
        "failedOrErrored": { "const": 0 }
      }
    },
    "reconciledExpectedIdentityCount": { "type": "integer", "minimum": 1 },
    "reconciledExpectedIdentitiesSha256": { "$ref": "#/$defs/sha256" },
    "counterfactualProjection": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceSelectionOutcome", "sourceSelectionCause", "reconciledSelectionOutcome", "reconciledSelectionCoverage"],
      "properties": {
        "sourceSelectionOutcome": { "const": "EVIDENCE_UNTRUSTED" },
        "sourceSelectionCause": { "const": "Executed JUnit identities differ from the tracked selection inventory." },
        "reconciledSelectionOutcome": { "const": "CONTRACT_SATISFIED" },
        "reconciledSelectionCoverage": { "const": "COMPLETE" }
      }
    },
    "otherJunitSelections": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["checkId", "selectionId", "executedIdentityCount", "executedIdentitiesSha256", "reconciledOutcome"],
        "properties": {
          "checkId": { "type": "string", "minLength": 1 },
          "selectionId": { "type": "string", "minLength": 1 },
          "executedIdentityCount": { "type": "integer", "minimum": 1 },
          "executedIdentitiesSha256": { "$ref": "#/$defs/sha256" },
          "reconciledOutcome": { "const": "CONTRACT_SATISFIED" }
        }
      }
    },
    "inventoryHashBefore": { "$ref": "#/$defs/sha256" },
    "inventoryHashAfter": { "$ref": "#/$defs/sha256" },
    "registryPinBefore": { "$ref": "#/$defs/sha256" },
    "registryPinAfter": { "$ref": "#/$defs/sha256" },
    "discoveryEvidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["module", "sha256", "junitFileCount"],
        "properties": {
          "module": { "enum": ["shared", "desktop"] },
          "sha256": { "$ref": "#/$defs/sha256" },
          "junitFileCount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "delta": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewedToMechanism", "mechanismToReconciliation", "reviewedToReconciliation"],
      "properties": {
        "reviewedToMechanism": { "$ref": "#/$defs/deltaList" },
        "mechanismToReconciliation": { "$ref": "#/$defs/deltaList" },
        "reviewedToReconciliation": { "$ref": "#/$defs/deltaList" }
      }
    },
    "productPayloadUnchanged": { "const": true },
    "scientificTestsUnchanged": { "const": true },
    "buildAuthorityUnchanged": { "const": true },
    "numericalReferencesUnchanged": { "const": true },
    "toolchainUnchanged": { "const": true },
    "verifierExecutionUnchanged": { "const": true },
    "heavyExecutionAuthoritiesUnchanged": { "const": true },
    "heavyExecutionPlanUnchanged": { "const": true },
    "acceptanceSemanticsUnchanged": { "const": true },
    "heavyCampaignRerun": { "const": false },
    "reconciliationStatus": { "enum": ["ACCEPTED", "REJECTED"] },
    "technicalAcceptanceEligible": { "type": "boolean" },
    "checkerIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["reconcilerAuthoritySha256", "sourceAuthoritySha256"],
      "properties": {
        "reconcilerAuthoritySha256": { "$ref": "#/$defs/sha256" },
        "sourceAuthoritySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "inputIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewedTrackedSha256", "reconciliationTrackedSha256"],
      "properties": {
        "reviewedTrackedSha256": { "$ref": "#/$defs/sha256" },
        "reconciliationTrackedSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceEnvironmentCompatibilitySignature", "sourceEnvironmentContractSha256"],
      "properties": {
        "sourceEnvironmentCompatibilitySignature": { "$ref": "#/$defs/sha256" },
        "sourceEnvironmentContractSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "locators": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceResultPath", "discoveryEvidencePaths"],
      "properties": {
        "sourceResultPath": { "type": "string", "minLength": 1 },
        "discoveryEvidencePaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "issued_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "oid": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
    "deltaList": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "status", "class"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "status": { "enum": ["A", "M", "D"] },
          "class": {
            "enum": [
              "DERIVED_JUNIT_INVENTORY", "DERIVED_REGISTRY_PIN", "RECONCILIATION_MECHANISM",
              "RECONCILIATION_CLOSEOUT_CONSUMER", "GOVERNANCE_POLICY_DOCUMENT",
              "DOCUMENTATION", "STATUS_RECORD"
            ]
          }
        }
      }
    }
  }
}
